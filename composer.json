{
    "name": "baznas-basel/website",
    "description": "Website BAZNAS Kabupaten Bangka Selatan",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-dom": "*",
        "ext-gd": "*",
        "ext-fileinfo": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "scripts": {
        "serve": "php -d upload_max_filesize=11M -d post_max_size=12M -S localhost:8000 -t public public/index.php",
        "build-css": "sh build-css.sh"
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "optimize-autoloader": true,
        "process-timeout": 0,
        "sort-packages": true
    }
}
