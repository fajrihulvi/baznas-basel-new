# Contoh .env untuk server produksi (cPanel). Salin menjadi .env di akar proyek (BUKAN di public/),
# isi nilai DB_*, lalu izinkan hanya pemilik membaca: chmod 600 .env
APP_NAME="BAZNAS Kabupaten Bangka Selatan"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://baznasbasel.id
APP_TIMEZONE=Asia/Jakarta

# Nyalakan setelah sertifikat SSL aktif (http:// & www. → https://baznasbasel.id)
APP_FORCE_HTTPS=true
# HSTS: isi 31536000 setelah HTTPS berjalan baik ±1 minggu (browser akan menolak http selama 1 tahun)
APP_HSTS=0

# cPanel → MySQL Databases (nama DB & user biasanya berawalan nama akun cPanel)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=baznasba_baznas
DB_USER=
DB_PASS=

# Hanya bila folder public/ dipisah ke public_html (kode di /home/USER/baznas-basel):
# dipakai skrip CLI/cron (cek_integritas, generate_image_variants). Halaman web mengenalinya otomatis.
# PUBLIC_PATH=/home/USERCPANEL/public_html

CACHE_ENABLED=true
CACHE_TTL=600

SESSION_NAME=baznas_sid
